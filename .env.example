# Copia este archivo a .env y rellena tus valores
# NUNCA subas el archivo .env a git
# En Netlify: Site configuration → Environment variables

# ── Stripe (pagos) ──────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# https://dashboard.stripe.com/webhooks (usa sk_test_... para pruebas)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email de aviso por cada pedido (opcional pero recomendado) ──
# Crea una cuenta gratis en https://resend.com y copia tu API key
RESEND_API_KEY=re_...
# Tu correo, donde quieres recibir el aviso de cada pedido
ORDER_EMAIL=tucorreo@ejemplo.com
# (Opcional) Remitente verificado en Resend. Si lo dejas vacío se usa
# el remitente de pruebas onboarding@resend.dev
FROM_EMAIL=What Maria Paints <onboarding@resend.dev>

# ── Galería Diaria (formulario curatorial) ─────────────────────
# (Opcional) Correo donde recibir el aviso de cada OBRA NUEVA enviada
# desde galeria/subir.html. Si lo dejas vacío se usa ORDER_EMAIL.
SUBMIT_EMAIL=curaduria@ejemplo.com

# ── Galería Diaria (curaduría: invitaciones + moderación) ──────
# Contraseña del panel de curaduría (galeria/curaduria.html). Elige una larga
# y privada: con ella se aprueban obras, se generan códigos y se editan reglas.
CURATOR_TOKEN=pon-aqui-una-contraseña-larga-y-secreta

# ── Galería Diaria (recordatorio diario por push) ──────────────
# Genera el par de claves una sola vez con:  npx web-push generate-vapid-keys
# y pégalas aquí. Sin ellas, el recordatorio funciona solo en modo local.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# (Opcional) Remitente de contacto que exige el estándar Web Push
VAPID_SUBJECT=mailto:hola@ejemplo.com

# ── Recordatorios de citas por WhatsApp ────────────────────────
# Guía completa: docs/RECORDATORIOS_WHATSAPP.md
# Google Calendar (cuenta de servicio con acceso de lectura a tu calendario)
GOOGLE_CALENDAR_ID=tucorreo@gmail.com
GOOGLE_CLIENT_EMAIL=recordatorios@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# WhatsApp Cloud API (Meta for Developers → tu app → WhatsApp)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Plantilla aprobada con {{1}} nombre, {{2}} fecha, {{3}} hora
WHATSAPP_TEMPLATE=recordatorio_cita
WHATSAPP_TEMPLATE_LANG=es
# (Opcional) Cuántas horas antes avisar, zona horaria y prefijo por defecto
RECORDATORIO_HORAS_ANTES=24
CALENDAR_TIMEZONE=Europe/Madrid
PREFIJO_PAIS=34
# Contraseña para /api/citas-prueba
CITAS_TOKEN=otra-contraseña-larga-y-secreta

# ── General ─────────────────────────────────────────────────────
# URL de tu web (Netlify la pone automáticamente)
URL=https://your-site.netlify.app
